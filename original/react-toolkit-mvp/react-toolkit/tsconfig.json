{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "declaration": true, "declarationMap": true,
    "sourceMap": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true, "esModuleInterop": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}