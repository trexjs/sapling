          "name": "Empty Bin",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bin",
              "host": ["{{baseUrl}}"],
              "path": ["bin"]
            }
          }
        }
      ]
    },
