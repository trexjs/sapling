    {
      "name": "Sharing",
      "item": [
        {
          "name": "Share Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{fileId}}\",\n  \"itemType\": \"File\",\n  \"sharedWith\": \"{{userId}}\",\n  \"permissions\": [\"read\", \"write\"],\n  \"expiresAt\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/share/share",
              "host": ["{{baseUrl}}"],
              "path": ["share", "share"]
            }
          }
        },
        {
          "name": "Get Shared With Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/share/shared-with-me?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["share", "shared-with-me"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Shared Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/share/my-shared?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["share", "my-shared"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Update Share Permissions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\"read\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/share/share/{{shareId}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["share", "share", "{{shareId}}", "permissions"]
